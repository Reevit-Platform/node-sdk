{
  "name": "@reevit/node",
  "version": "0.10.0",
  "description": "Reevit Node.js & TypeScript SDK — Unified payment orchestration for Africa (Paystack, Hubtel, Flutterwave, M-Pesa, Moolre, Monnify, PawaPay, Stripe)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "contract:generate": "node scripts/generate-openapi-contract.mjs",
    "contract:check": "node scripts/check-openapi-contract.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "reevit",
    "payment-orchestration",
    "payments",
    "africa",
    "ghana",
    "nigeria",
    "kenya",
    "mobile-money",
    "paystack",
    "hubtel",
    "flutterwave",
    "mpesa",
    "moolre",
    "monnify",
    "pawapay",
    "stripe"
  ],
  "author": "Reevit <support@reevit.io> (https://reevit.io)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Reevit-Platform/node-sdk.git"
  },
  "homepage": "https://reevit.io",
  "bugs": {
    "url": "https://github.com/Reevit-Platform/node-sdk/issues"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^18.0.0"
  },
  "dependencies": {
    "axios": "^1.4.0"
  }
}
